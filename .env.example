# Logging & ProtocoL
LOG_LEVEL=INFO
LOG_FORMAT=json
# ONNX / ML Silence
ORT_LOGGING_LEVEL=3
TF_CPP_MIN_LOG_LEVEL=3
TOKENIZERS_PARALLELISM=false

# Yol Yapılandırması
# Host makinedeki projelerin kök dizini
HOST_PROJECTS_ROOT=/Volumes/MacBook/RiderProjects
# Host makinedeki GraphRagMCP uygulama dizini
HOST_APP_ROOT=/Volumes/MacBook/RiderProjects/GraphRagMCP
# Container içindeki projelerin mount noktası
CONTAINER_PROJECTS_ROOT=/projects
TZ=Europe/Istanbul

# OpenRouter API anahtarı — https://openrouter.ai/keys adresinden alınır
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Koleksiyon ve model ayarları
COLLECTION_NAME=my_project
DEFAULT_COLLECTION=my_project
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_MODEL=gpt-4o-mini
ANALYSIS_MODEL=openai/gpt-4o-mini
REASONING_MODEL=openai/o4-mini

# Docker servis secret'ları
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
PGADMIN_DEFAULT_PASSWORD=${PGADMIN_DEFAULT_PASSWORD}

# Veritabanı ve Servis Ayarları
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD}
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6380/0

# Retrieval & Context Ayarları
DEFAULT_TOKEN_BUDGET=1800
MAX_CONTEXT_CHUNKS=8
MIN_FINAL_SCORE=0.05
CONTEXT_CHARS_PER_TOKEN=4.0

# Bütçe ve Güvenlik (Guardrails)
BUDGET_TASK_MAX_TOKENS=50000
BUDGET_TASK_MAX_LLM_CALLS=20
BUDGET_DAILY_MAX_USD=10.0
BUDGET_DAILY_MAX_TOKENS=1000000

GUARDRAIL_ENABLED=true
GUARDRAIL_TOKEN_HARD_LIMIT=5000
GUARDRAIL_MAX_TOTAL_LLM_CALLS=2
GUARDRAIL_MAX_AUX_LLM_CALLS=1
GUARDRAIL_MAX_RETRIEVAL_RETRIES=2

# Sıkıştırma (Compressor)
COMPRESSOR_ENABLED=true
COMPRESSOR_MAX_RATIO=0.6

# Sandbox Güvenliği
MOUNT_READONLY_PATHS=/projects
MOUNT_READWRITE_PATHS=/tmp
TOOL_POLICY_EXTRA_ALLOWED=

# Gözlemlenebilirlik (OpenTelemetry + Prometheus)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317   # Opsiyonel — OTLP endpoint
PROMETHEUS_ENABLED=true

# Güvenlik (Secret Scanner + CrossEncoder)
# SECRET_BYPASS_FILES=                             # Virgülle ayrılmış dosya isimleri (production'da boş bırakın)
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENVIRONMENT=production

# ── Agent API (TDAD Orchestration) ───────────────────────────────────────────
# Complexity Router
COMPLEXITY_ROUTER_ENABLED=true
TIER_LOCAL_ENABLED=false
TIER_LOCAL_MODEL=qwen2.5-coder:32b
TIER_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
TIER_LOCAL_FALLBACK_MODEL=deepseek-coder-v2:16b
TIER_CHEAP_MODEL=google/gemini-2.5-flash
TIER_CHEAP_FALLBACK=mistralai/codestral-latest
TIER_REASON_MODEL=anthropic/claude-sonnet-4-6
TIER_REASON_FALLBACK=deepseek/deepseek-v3
CONTEXT_BUDGET_LOCAL=8000
CONTEXT_BUDGET_CHEAP=16000
CONTEXT_BUDGET_REASON=32000
COMPLEXITY_LOCAL_THRESHOLD=0.30
COMPLEXITY_REASON_THRESHOLD=0.70
OLLAMA_LATENCY_THRESHOLD_MS=5000

# TDAD Loop
HITL_TIMEOUT_SECONDS=300
CODEACT_MAX_REFLECTIONS=5
VERIFY_TIMEOUT_SECONDS=120
SESSION_CONTEXT_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=120

# Workspace
WORKSPACE_BASE_PATH=/var/lib/graphrag/workspaces
SNAPSHOT_RETENTION_HOURS=24
MAX_SNAPSHOTS_PER_PROJECT=20

# Feature Flags (Sprint 3/4'te etkinleştirilecek)
PATCH_MEMORY_ENABLED=false
SEMANTIC_DIFF_ENABLED=false

# Impact Analysis Ağırlıkları
IMPACT_W_CALL_GRAPH=0.40
IMPACT_W_DEP_GRAPH=0.30
IMPACT_W_PAGERANK=0.20
IMPACT_W_CO_CHANGE=0.10
