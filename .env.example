# OpenRouter API anahtarı — https://openrouter.ai/keys adresinden alınır
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Koleksiyon ve model ayarları
COLLECTION_NAME=my_project
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Araçların varsayılan koleksiyonu — projeye göre değiştir
DEFAULT_COLLECTION=my_project

# explain_code ve rewrite_query için kullanılan LLM modeli
ANALYSIS_MODEL=openai/gpt-4o-mini

# Docker servis secret'ları
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
PGADMIN_DEFAULT_PASSWORD=${PGADMIN_DEFAULT_PASSWORD}

# Neo4j Ayarları
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=${NEO4J_USER}
NEO4J_PASSWORD=${NEO4J_PASSWORD}
