# OpenRouter API anahtarı — https://openrouter.ai/keys adresinden alınır
OPENROUTER_API_KEY=sk-or-BURAYA_KENDI_ANAHTARINI_YAZ

# Koleksiyon ve model ayarları
COLLECTION_NAME=my_project
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Araçların varsayılan koleksiyonu — projeye göre değiştir
DEFAULT_COLLECTION=my_project

# explain_code ve rewrite_query için kullanılan LLM modeli
ANALYSIS_MODEL=openai/gpt-4o-mini

# Neo4j Ayarları
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
